{
  "name": "@nourishbudget/backend",
  "version": "1.0.0",
  "private": true,
  "description": "NestJS API for NourishBudget / Back To Eden",
  "scripts": {
    "build": "node node_modules/typescript/bin/tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "node node_modules/ts-node/dist/bin.js src/main.ts",
    "lint": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "npm run build && node --test --test-concurrency=4 \"test/*.test.mjs\"",
    "schema": "node scripts/schema.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
