# Copy to .env and fill in. .env is gitignored; this file is not.

# Who may moderate the Community Kitchen: comma separated, no spaces needed.
# Matched against the signed-in email. Leave it empty and there are no admins -
# the admin page stays hidden and every moderation route answers 403.
#
# These addresses cannot be registered from the web. Give each one a password
# on the server: node dist/cli/set-password.js <email> "Name"
ADMIN_EMAILS=you@example.com

# Google Gemini key for the Leftover Assistant and machine translation.
# Without it both fall back gracefully: recipes are unavailable and untranslated
# strings stay in English.
GEMINI_API_KEY=

# Optional. Which proxies to trust for the visitor's real IP (used by sign-in
# rate limits). Default trusts private-network proxies such as Docker's nginx.
# TRUST_PROXY=1
